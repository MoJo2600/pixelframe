// For format details, see https://aka.ms/devcontainer.json
{
	"name": "PixelFrame Development",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Run arguments for the container
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt", "seccomp=unconfined"
	],

	// Mount USB devices if available (comment out if not using hardware)
	// "mounts": [
	// 	"source=/dev/ttyUSB0,target=/dev/ttyUSB0,type=bind"
	// ],

	// Forward ports for web development
	"forwardPorts": [
		3000,  // Mock API server
		5173   // Vite dev server
	],

	// VS Code customizations (new format)
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"[cpp]": {
					"editor.defaultFormatter": "ms-vscode.cpptools"
				},
				"[typescript]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[vue]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"platformio-ide.useBuiltinPython": false,
				"platformio-ide.customPATH": "/opt/platformio-venv/bin"
			},
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"platformio.platformio-ide",
				"Vue.volar",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"EditorConfig.EditorConfig",
				"ms-vscode.vscode-typescript-next"
			]
		}
	},

	// Features to add to the container
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},

	// Commands to run after container creation
	"postCreateCommand": "cd /workspaces/pixelframe/web && npm install",

	// Commands to run after container starts
	"postStartCommand": "pio system info || true",

	// Use non-root user
	"remoteUser": "vscode"
}