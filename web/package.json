{
  "name": "pixelframe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "",
  "author": "",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mock": "concurrently \"npm run mock-api\" \"vite --host 0.0.0.0\"",
    "mock-api": "json-server --watch mock-api/db.json --routes mock-api/routes.json --middlewares mock-api/middlewares/pixelframe.cjs --port 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.mts,.mtsx --fix --ignore-path .gitignore",
    "test:ui": "npm run dev:mock"
  },
  "dependencies": {
    "@mdi/font": "^7.4.0",
    "axios": "^1.7.0",
    "core-js": "^3.36.0",
    "lodash": "^4.17.21",
    "pinia": "^2.1.0",
    "uuid": "^9.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuetify": "^3.6.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@types/lodash": "^4.14.195",
    "@types/node": "^25.1.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.20.0",
    "json-server": "^0.17.3",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12"
  }
}
